import express from 'express';
import cors from 'cors';

const app = express();
const port = process.env.PORT || 5000;

app.use(cors());
app.use(express.json());

app.get('/api/health', (req, res) => {
  res.json({
    status: 'ok',
    app: 'rajasthan-bhunaksha-gis',
    location: 'Bawarla, Sanchor, Jalore, Rajasthan',
  });
});

app.get('/api/project', (req, res) => {
  res.json({
    name: 'GeoKhet Rajasthan GIS',
    area: 'Bawarla, Sanchor, Jalore, Rajasthan',
    features: [
      'Satellite view',
      'Bhunaksha overlay support',
      'Custom image upload',
      'Website capture overlay',
      'Manual alignment tools',
    ],
  });
});

app.listen(port, () => {
  console.log(`GeoKhet GIS API listening on http://localhost:${port}`);
});
